# Local application
API_PORT=8787
DATABASE_PATH=.data/genkan-ai.sqlite
RETENTION_DAYS=7
CHILD_SAFETY_MODE=true

# Cloud speech recognition (default for this MVP).
STT_PROVIDER=groq-whisper
GROQ_API_KEY=
GROQ_WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_PROMPT=住宅のインターホン。配達、宅配、荷物、営業、点検、集金、訪問。
GROQ_WHISPER_TIMEOUT_MS=15000

# Optional local fallback. Set STT_PROVIDER=local-whisper to use it.
WHISPER_SERVER_URL=http://127.0.0.1:8080
WHISPER_MODEL_PATH=.models/whisper/ggml-medium.bin
WHISPER_LANGUAGE=ja

# Use "gemini" for the free-tier voice MVP, "mock" for a secret-free UI demo,
# or "sakana-fugu" / "openai" for the alternative adapters.
CONVERSATION_PROVIDER=gemini

# Gemini API free-tier default. Create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_EFFORT=low
GEMINI_TIMEOUT_MS=20000

# Optional Sakana Fugu fallback.
SAKANA_API_KEY=
SAKANA_API_URL=https://api.sakana.ai/v1/responses
SAKANA_MODEL=fugu
SAKANA_REASONING_EFFORT=high
SAKANA_TIMEOUT_MS=20000

# Optional alternative conversation provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Fish Audio is optional at runtime. TTS is pinned to S2.1 Pro Free and the
# public Japanese voice "落ち着いた女性". Change the reference ID to use another public voice.
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=0089dce5fefb4c6ba9b9f2f0debe1ddc
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_API_URL=https://api.fish.audio/v1/tts

# Vite
VITE_APP_ENV=development
